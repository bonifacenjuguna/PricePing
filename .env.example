# --- Existing vars — same names as your current Railway deployment, ---
# --- nothing here was renamed. Your existing Railway project already ---
# --- has these set; you do not need to touch them. ---
BOT_TOKEN=
BOT_NAME=PricePing
ADMIN_TELEGRAM_ID=
ADMIN_NAME=
CHANNEL_ID=

WEBHOOK_URL=
WEBHOOK_PATH=/telegram-webhook
WEBHOOK_SECRET=
PORT=3000

DATABASE_URL=
REDIS_URL=

POLL_INTERVAL_MS=30000
COOLDOWN_MINUTES=5
BINANCE_FAILURE_ALERT_THRESHOLD=10

MEMORY_LIMIT_MB=220
MEMORY_CHECK_INTERVAL_MS=60000
MEMORY_WARN_RATIO=0.8

SEND_DELAY_MS=250
MAX_ALERTS_PER_HOUR=20

DIGEST_HOUR_UTC=9
DIGEST_ENABLED=true

HEARTBEAT_CHECK_INTERVAL_MS=300000
HEARTBEAT_STALE_MULTIPLIER=3

# --- New in v1.0.0 — add these to Railway once, nothing else changes. ---

# Binance auto-sync (replaces manual /addcoin)
BINANCE_QUOTE_ASSET=USDT
BINANCE_SYNC_INTERVAL_MS=21600000

# Tier assignment (by 24h volume rank) + per-tier default threshold %
TIER_MAJOR_RANK_MAX=10
TIER_MID_RANK_MAX=50
TIER_MAJOR_THRESHOLD_PCT=2
TIER_MID_THRESHOLD_PCT=4
TIER_MICRO_THRESHOLD_PCT=8

# Bot Mode — DB setting overrides this after the first manual switch
DEFAULT_BOT_MODE=cruise

# Timezone — DB setting overrides this after it's set via the menu
DEFAULT_TIMEZONE=UTC

# Automation base intervals (ms) — Bot Mode scales these
CHART_BASE_INTERVAL_MS=14400000
MOVERS_BASE_INTERVAL_MS=21600000
FEARGREED_BASE_INTERVAL_MS=86400000

# Anti-Spam mode's extra restriction
ANTI_SPAM_MAX_POSTS_PER_DAY=12
