# --- Telegram ---
BOT_TOKEN=                     # from @BotFather
ADMIN_TELEGRAM_ID=              # your numeric Telegram user ID (only this ID can talk to the bot)
ADMIN_NAME=Admin
VIEWER_TELEGRAM_IDS=              # optional, comma-separated: read-only co-admins (e.g. 111111,222222)
CHANNEL_ID=@PricePing           # channel username or -100xxxxxxxxxx numeric ID; bot must be a channel admin

# --- Webhook (production) ---
# Leave WEBHOOK_URL unset for local dev — the bot falls back to long-polling automatically.
WEBHOOK_URL=                    # e.g. https://your-app.up.railway.app  (Railway sets a public URL automatically)
WEBHOOK_PATH=/telegram-webhook
WEBHOOK_SECRET=                 # optional random string, adds a secret-token check on the webhook endpoint
PORT=3000

# --- Storage ---
DATABASE_URL=                   # Railway Postgres plugin sets this automatically
REDIS_URL=                      # Railway Redis plugin sets this automatically

# --- Polling / alerting behavior ---
POLL_INTERVAL_MS=30000          # 30 seconds
COOLDOWN_MINUTES=5              # minimum time between two alerts for the same coin
BINANCE_FAILURE_ALERT_THRESHOLD=10   # consecutive failed ticks before admin gets notified
SEND_DELAY_MS=250               # delay between sequential channel sends when multiple coins alert in one tick

# --- Memory watchdog (Railway free tier = 512MB) ---
MEMORY_LIMIT_MB=220             # heap threshold that triggers a graceful restart
MEMORY_CHECK_INTERVAL_MS=60000
MEMORY_WARN_RATIO=0.8           # restart once heap crosses 80% of MEMORY_LIMIT_MB

# --- v0.2.0: hourly cap, digest, heartbeat watchdog ---
MAX_ALERTS_PER_HOUR=20          # rolling 60-minute cap on channel sends across all coins
DIGEST_ENABLED=true             # set false to disable the daily summary post entirely
DIGEST_HOUR_UTC=9               # hour (0-23, UTC) the daily digest posts
HEARTBEAT_CHECK_INTERVAL_MS=300000   # how often the dead-man's-switch checks the poller (5 min)
HEARTBEAT_STALE_MULTIPLIER=3    # DM the admin if no tick in POLL_INTERVAL_MS * this many
